# DIAL port of the first renderer; each next renderer uses the next port.
DIAL_PORT=3100
# Port of the streams and the control API.
HTTP_PORT=8100
# How YouTube senders see each renderer; {name} is the renderer's own name.
SCREEN_NAME=🔊 {name}
# Set to false to keep the yt-dlp release in the image.
YTDLP_UPDATE=true
